# Public settings only.
# Everything that starts with VITE_ is compiled into the browser bundle, so
# anyone can read it. NEVER put a secret, service-role key, JWT secret or
# database URL in this file or in any VITE_ variable.

# Base URL of the backend API, including /api.
# Leave empty to use /api on the same host.
VITE_API_URL=http://localhost:4000/api

# true  = run on built-in demo data (no backend needed)
# false = talk to the real backend. Must be false for production.
VITE_USE_MOCK=true
