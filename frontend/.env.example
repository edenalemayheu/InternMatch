# Public settings only.
# Everything that starts with VITE_ is compiled into the browser bundle, so
# anyone can read it. NEVER put a secret, service-role key, JWT secret or
# database URL in this file or in any VITE_ variable.

# Backend API base URL, including /api.
# Leave EMPTY in development: the Vite dev server forwards /api to
# http://localhost:3001 (see vite.config.js).
# In production set it to the deployed backend, e.g. https://your-backend.vercel.app/api
VITE_API_URL=
