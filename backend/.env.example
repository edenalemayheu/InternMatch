# Server-side secrets. This file is a template. Copy it to backend/.env
# (which is git-ignored) and fill in real values there. Never commit them.
PORT=4000
CORS_ORIGIN=http://localhost:5173

# From the Supabase dashboard (Project Settings > API / Database).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://postgres:replace-me@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
