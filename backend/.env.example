# Server-side secrets. This file is a template: copy it to backend/.env
# (git-ignored) and put the real values there. Never commit real values.

# Port for local development. The frontend dev server proxies /api to 3001.
PORT=3001

# Where your frontend runs. In production set it to the deployed frontend URL;
# several origins can be separated by commas. REQUIRED when NODE_ENV=production,
# otherwise the server refuses to start.
FRONTEND_ORIGIN=http://localhost:5173

# From the Supabase dashboard (Project Settings > API Keys).
# The service-role / secret key bypasses Row Level Security. Backend only.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Only if you need POST /api/admin/seed on a production demo server:
# ALLOW_SEED=true
